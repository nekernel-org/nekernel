{
  "compiler_path": "x86_64-w64-mingw32-g++",
  "compiler_std": "c++20",
  "headers_path": ["../libSystem", "../", "./"],
  "sources_path": ["src/*.cpp"],
  "output_name": "Thread.dll",
  "compiler_flags": [
    "-ffreestanding",
    "-shared",
    "-fPIC",
    "-fno-rtti",
    "-fno-exceptions",
    "-Wl,--subsystem=17",
    "-L../libSystem",
    "-lSystem"
  ],
  "cpp_macros": [
    "kLibThreadVersion=0x0100",
    "kLibThreadVersionHighest=0x0100",
    "kLibThreadVersionLowest=0x0100"
  ],
  "description": "The System Thread Kit for the NeKernel."
}

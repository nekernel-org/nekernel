{
  "compiler_path": "x86_64-w64-mingw32-g++",
  "compiler_std": "c++20",
  "headers_path": ["../libSystem", "../", "../../public/frameworks", "./"],
  "sources_path": ["src/*.cpp"],
  "output_name": "Msg.dll",
  "compiler_flags": [
    "-ffreestanding",
    "-shared",
    "-fPIC",
    "-fno-rtti",
    "-L../libSystem",
    "-lSystem",
    "-fno-exceptions",
    "-Wl,--subsystem=17"
  ],
  "cpp_macros": [
    "kMsgVersion=0x0100",
    "kMsgVersionHighest=0x0100",
    "kMsgVersionLowest=0x0100"
  ],
  "description": "OpenMessage Kit for the NeKernel."
}
